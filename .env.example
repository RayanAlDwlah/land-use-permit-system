# Copy to .env and replace every value before running:
#   cp .env.example .env
# docker compose reads .env from this directory and substitutes the values
# into docker-compose.yml.

# ==== Postgres ====
POSTGRES_DB=land
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# ==== Backend ====
SERVER_PORT=8080
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ==== JWT ====
# HS256 signing key; must be at least 32 characters.
APP_JWT_SECRET=replace-with-a-long-random-secret
# Token lifetime in milliseconds (86400000 = 24 hours)
APP_JWT_EXPIRATION=86400000

# ==== Upload dir inside the backend container ====
APP_UPLOAD_DIR=/data/uploads
